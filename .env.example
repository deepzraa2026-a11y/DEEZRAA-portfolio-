# PORT: Port on which the Express server listens.
PORT=3000

# ADMIN_USERNAME: Username for the secure admin dashboard.
ADMIN_USERNAME="change-me"

# ADMIN_PASSWORD: Strong password for the secure admin dashboard.
ADMIN_PASSWORD="change-me"

# SESSION_SECRET: Long random phrase used to sign admin session tokens.
SESSION_SECRET="replace-with-a-long-random-secret"

# APP_URL: Public URL where the site is hosted.
APP_URL="http://localhost:3000"

# Optional storage overrides (useful for read-only/serverless hosts such as Vercel).
# DATA_DIR=/tmp/deezraa/data
# UPLOADS_DIR=/tmp/deezraa/uploads

# Vercel Blob persistence (production only).
# On Vercel these variables are created automatically when you connect Blob
# stores to the project. Locally they can be left unset.
# BLOB_STORE_ID: private store that keeps the durable SQLite snapshot.
# DEEZRAA_IMAGES_STORE_ID: public store that keeps uploaded scene images.
# BLOB_STORE_ID=
# DEEZRAA_IMAGES_STORE_ID=

# Optional static read/write tokens if OIDC is not available.
# BLOB_READ_WRITE_TOKEN=
# DEEZRAA_IMAGES_READ_WRITE_TOKEN=
